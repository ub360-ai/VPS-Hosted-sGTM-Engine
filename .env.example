# sGTM Cluster Environment Variables
# Copy to .env and fill in your values

# --- Required ---
# sGTM container configuration string (from GTM Admin > Container > Settings)
CONTAINER_CONFIG=your_container_config_string_here

# Preview server URL (used by tagging container to reach the preview service)
PREVIEW_SERVER_URL=https://devsgtm.updates24-7.swiftloopmarketing.com/preview

# --- Go Runtime Tuning ---
# Number of OS threads the Go runtime will use (default: 4)
GOMAXPROCS=4
# Soft memory limit for the Go garbage collector (default: 2048MiB)
GOMEMLIMIT=2048MiB
# GC target percentage — 100 = default, lower = more frequent GC but less peak memory (default: 100)
GOGC=100

# --- Tagging Container Resources ---
# NOTE: Replicas are set via deploy.replicas in docker-compose.yml (currently: 3).
# IMPORTANT: In Coolify Service > Advanced, DISABLE both:
#   "Consistent Container Names" and "Custom Container Name"
# These inject container_name which conflicts with deploy.replicas.
# Hard memory limit per tagging container (default: 2560m)
TAGGING_MEM_LIMIT=2560m
# Soft memory reservation per tagging container (default: 1024m)
TAGGING_MEM_RESERVATION=1024m
# CPU cores per tagging container (default: 4)
TAGGING_CPUS=4

# --- Preview Container Resources ---
# Hard memory limit for the preview container (default: 1536m)
PREVIEW_MEM_LIMIT=1536m
# Soft memory reservation for the preview container (default: 512m)
PREVIEW_MEM_RESERVATION=512m
# CPU cores for the preview container (default: 2)
PREVIEW_CPUS=2

# --- Redis ---
# Hard memory limit for Redis (default: 768m)
REDIS_MEM_LIMIT=768m
# CPU cores for Redis (default: 1)
REDIS_CPUS=1
